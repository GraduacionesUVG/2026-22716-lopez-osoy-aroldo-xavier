OPENAI_API_KEY=coloca_tu_api_key_aqui

CIE10_SOURCE_MODE=local
CIE10_OPENAI_MODEL=gpt-6-luna
CIE10_REASONING_EFFORT=medium
CIE10_MAX_RECORDS=10
CIE10_REPAIR_ATTEMPTS=2

# Local CSV mode
CIE10_CATALOG_CSV_PATH=./CIE10.csv
CIE10_TRANSLATOR_CSV_PATH=./CIE10_Traductor.csv
CIE10_REFERENCE_CSV_PATH=./cie-10-reference.csv
CIE10_COMMAND=batch
CIE10_BATCH_PERIOD=
CIE10_VECTOR_BUCKET_NAME=
CIE10_VECTOR_INDEX_NAME=
CIE10_EMBEDDING_PROVIDER=openai
CIE10_EMBEDDING_MODEL=text-embedding-3-small
CIE10_EMBEDDING_DIMENSIONS=512
CIE10_RAG_VERSION=2026-10-17
# CIE10_ACTIVATE_RAG=false

# S3 mode
# CIE10_SOURCE_MODE=s3
# CIE10_CATALOG_S3_URI=s3://congenia-prod-docs/cie10/input/CIE10.csv
# CIE10_TRANSLATOR_S3_URI=s3://congenia-prod-docs/cie10/input/CIE10_Traductor.csv
# Para S3 compatible local como SeaweedFS/MinIO:
# CIE10_S3_ENDPOINT=http://localhost:8333
# CIE10_S3_ACCESS_KEY_ID=congenia
# CIE10_S3_SECRET_ACCESS_KEY=congenia
# CIE10_S3_FORCE_PATH_STYLE=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=congenia
POSTGRES_USER=congenia
POSTGRES_PASSWORD=congenia
PGSSLMODE=disable

# Opcional: ajusta pausas y reintentos si encuentras rate limits.
# OPENAI_REQUEST_DELAY_MS=750
# OPENAI_MAX_RETRIES=2
# OPENAI_RETRY_BASE_DELAY_MS=1000
