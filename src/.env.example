# PostgreSQL local
POSTGRES_DB=congenia
POSTGRES_USER=congenia
POSTGRES_PASSWORD=change_me_local_postgres
POSTGRES_APP_USER=congenia_app
POSTGRES_APP_PASSWORD=change_me_local_postgres_app
POSTGRES_PORT=5432

# API
NODE_ENV=development
APP_ENV=development
API_PORT=3000
AUTH_INTEGRATION_MODE=hybrid
ALLOW_DEV_SESSION=false
APP_ENCRYPTION_KEY=change_me_local_64_hex_characters
PATIENT_NAME_TOKEN_HMAC_KEY=change_me_local_patient_hmac_key
SESSION_EXPIRY_MINUTES=60
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Keycloak local
KEYCLOAK_VERSION=26.6.1
KEYCLOAK_PORT=8082
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_local_keycloak_admin
KEYCLOAK_SADC_CLIENT_SECRET=change_me_local_sadc_client
KEYCLOAK_MEDICO_INITIAL_PASSWORD=ChangeMeLocalMedico2026
OIDC_ISSUER_URL=http://keycloak:8080/realms/congenia
OIDC_ISSUER_URLS=http://localhost:8082/realms/congenia,http://keycloak:8080/realms/congenia
OIDC_JWKS_URL=http://keycloak:8080/realms/congenia/protocol/openid-connect/certs
OIDC_AUDIENCE=congenia-api
OIDC_WEB_CLIENT_ID=congenia-web

# Redis
REDIS_VERSION=7.2-alpine
REDIS_PASSWORD=change_me_local_redis
REDIS_PORT=6379

# RabbitMQ and PDF worker
RABBITMQ_DEFAULT_USER=congenia
RABBITMQ_DEFAULT_PASS=change_me_local_rabbitmq
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_QUEUE_MAIN=consent.pdf.generate
RABBITMQ_QUEUE_DLQ=consent.pdf.generate.dlq
WORKER_PREFETCH=3
WORKER_MAX_RETRIES=5
WORKER_RETRY_BACKOFF_MS=2000
WORKER_RETRY_BACKOFF_MULTIPLIER=2

# Local S3-compatible storage
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=congenia-docs
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change_me_local_s3_access
S3_SECRET_ACCESS_KEY=change_me_local_s3_secret
S3_UPLOAD_MAX_BYTES=10485760
S3_PRESIGN_EXPIRY_SECONDS=300
SEAWEED_VERSION=latest
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_PORT=8081
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MAX_VOLUMES=50
SEAWEED_VOLUME_SIZE_LIMIT=30000

# Frontend
FRONTEND_PORT=8080
API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development
FRONTEND_BASE_URL=http://localhost:8080
FRONTEND_FICHA_ROUTE=/
VITE_OIDC_AUTHORITY=http://localhost:8082/realms/congenia
VITE_OIDC_CLIENT_ID=congenia-web
VITE_OIDC_REDIRECT_URI=http://localhost:8080/
VITE_FHIR_BASE_URL=https://fhir.example.invalid/r4
USE_FICHA_SEARCH_MOCK=false
USE_ADENDAS_MOCK=false
USE_CIE10_MOCK=false

# CIE-10 batch. Real API keys are never committed.
OPENAI_API_KEY=
CIE10_SOURCE_MODE=local
CIE10_CATALOG_CSV_PATH=/data/CIE10.csv
CIE10_TRANSLATOR_CSV_PATH=/data/CIE10_Traductor.csv
CIE10_MAX_RECORDS=10
CIE10_OPENAI_MODEL=gpt-6-luna
CIE10_REASONING_EFFORT=medium
CIE10_REPAIR_ATTEMPTS=2
CIE10_REVIEW_EXPORT_S3_PREFIX=s3://congenia-docs/cie10-exports/
CIE10_S3_ENDPOINT=http://seaweedfs:8333
CIE10_S3_REGION=us-east-1
CIE10_S3_ACCESS_KEY_ID=change_me_local_s3_access
CIE10_S3_SECRET_ACCESS_KEY=change_me_local_s3_secret
CIE10_S3_FORCE_PATH_STYLE=true

# Reporting agent. Use only a desidentified local dataset.
REPORTING_DATABASE_APP_URL=
REPORTING_DATABASE_AGENT_READONLY_URL=
REPORTING_STATEMENT_TIMEOUT_MS=5000
REPORTING_MCP_TOKEN=change_me_local_reporting_mcp
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
REPORTING_CONVERSATION_TTL_SECONDS=1800
REPORTING_CONVERSATION_MAX_TURNS=8
AGENT_PROMPT_VERSION=agent-reporting-v1
DATASET_VERSION=synthetic-local
REPORTING_SCHEMA_VERSION=reporting-v1

# Optional development playground
PLAYGROUND_PORT=5173
PLAYGROUND_VITE_API_URL=http://localhost:3000/v1
PLAYGROUND_VITE_API_INTEGRATION_URL=http://localhost:3000/api/v1
PLAYGROUND_KEYCLOAK_PROXY_TARGET=http://keycloak:8080
PLAYGROUND_KEYCLOAK_TOKEN_URL=/keycloak/realms/congenia/protocol/openid-connect/token
PLAYGROUND_KEYCLOAK_CLIENT_ID=sadc
PLAYGROUND_KEYCLOAK_CLIENT_SECRET=change_me_local_sadc_client
PLAYGROUND_KEYCLOAK_SCOPE=congenia.sessions:init
PLAYGROUND_VITE_OFFICIAL_FORM_URL=http://localhost:8080/
PLAYGROUND_VITE_FICHA_URL=http://localhost:5173/ficha
PLAYGROUND_PATIENT_ID=synthetic-patient
PLAYGROUND_PATIENT_NOMBRE="Paciente Sintetico"
PLAYGROUND_FECHA_CONSULTA=2026-01-15
PLAYGROUND_DIAGNOSTICO="Diagnostico sintetico"
PLAYGROUND_MEDICO_ID=synthetic-doctor
PLAYGROUND_MEDICO_NOMBRE="Medico de Prueba"
PLAYGROUND_ESPECIALIDAD=Genetica

# Local image versions
API_VERSION=1.0.0
FRONTEND_VERSION=1.0.0
PDF_WORKER_VERSION=1.0.0
