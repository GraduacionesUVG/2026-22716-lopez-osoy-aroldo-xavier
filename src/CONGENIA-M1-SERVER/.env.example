# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=congenia
POSTGRES_USER=congenia_user
POSTGRES_PASSWORD=

# ── Integración con sistemas externos ────────────────────────
# 64 hex characters (32 bytes) for AES-256-GCM encryption of patient_payload_enc
APP_ENCRYPTION_KEY=
# Minutes before a PENDIENTE session token expires
SESSION_EXPIRY_MINUTES=15
# Base URL of the frontend (Playground), used to build formUrl, here frontend might set not playgroud
FRONTEND_BASE_URL=http://localhost:5174
# Route path in the frontend where the ficha form lives
FRONTEND_FICHA_ROUTE=/ficha

# OAuth 2.0 / Keycloak integration
OIDC_ISSUER_URL=http://localhost:8082/realms/congenia
OIDC_JWKS_URL=http://localhost:8082/realms/congenia/protocol/openid-connect/certs
OIDC_AUDIENCE=congenia-api
OIDC_WEB_CLIENT_ID=congenia-web

# Redis cache for temporary integration sessions
REDIS_URL=redis://:change-me@localhost:6379
# En AWS se usan variables separadas para no interpolar el secreto en una URL:
# REDIS_HOST=cache.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=true

# ── SeaweedFS / S3 ────────────────────────────────────────────
# Endpoint interno para operaciones servidor->SeaweedFS
S3_ENDPOINT=http://localhost:8333
# Endpoint publico (alcanzable por navegador) usado para firmar presigned URLs
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=congenia-docs
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=congenia
S3_SECRET_ACCESS_KEY=congenia
# Seconds a presigned PUT URL is valid (default 3600 = 1 hour)
S3_PRESIGN_EXPIRY_SECONDS=3600
# Maximum file size accepted when issuing a presigned PUT URL (10 MiB)
S3_UPLOAD_MAX_BYTES=10485760
# Maximum size of the consent signature PNG stored in S3 (default 200 KiB)
CONSENT_SIGNATURE_MAX_BYTES=204800

# External reporting database and Text-to-SQL agent.
REPORTING_DATABASE_APP_URL=
REPORTING_DATABASE_AGENT_READONLY_URL=
REPORTING_STATEMENT_TIMEOUT_MS=5000
REPORTING_MCP_TOKEN=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
REPORTING_CONVERSATION_TTL_SECONDS=1800
REPORTING_CONVERSATION_MAX_TURNS=8
AGENT_PROMPT_VERSION=agent-reporting-v1
DATASET_VERSION=unset
REPORTING_SCHEMA_VERSION=reporting-v1
