# =============================================================================
# CONGENIA M1 — Frontend
#
# Estas variables son de DESARROLLO (`pnpm dev`). En un contenedor NO se usan:
# la configuracion se resuelve al arrancar desde API_BASE_URL y APP_ENV, que
# lee docker-entrypoint.d/40-congenia-runtime-config.sh y escribe en config.js.
# =============================================================================

# CONGENIA M1 Backend API
# Development:  http://localhost:3000
# Detras del ALB: dejar vacio — frontend y API comparten origen y basta con
# rutas relativas (/v1/...).
VITE_API_BASE_URL=http://localhost:3000

# OpenID Connect (Authorization Code + PKCE)
VITE_OIDC_AUTHORITY=http://localhost:8082/realms/congenia
VITE_OIDC_CLIENT_ID=congenia-web

# FHIR
VITE_FHIR_BASE_URL=https://fhir.tuservidor.gt/r4

# Entorno
VITE_APP_ENV=development

# Sesion de desarrollo: ficha y medico de mentira (superadmin), sin Keycloak ni
# SADC. Apagada por defecto; ponerla en true solo en local.
VITE_ALLOW_DEV_SESSION=false
