{
  "name": "congenia-reporting-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "anonymize:sigsa": "tsx src/commands/anonymizeSigsa.ts",
    "validate:sigsa": "tsx src/commands/validateSigsa.ts",
    "import:sigsa": "tsx src/commands/importSigsa.ts",
    "evaluate:agent": "tsx src/commands/evaluateAgent.ts",
    "evaluate:agent:combine": "tsx src/commands/combineAgentReports.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "security:fixtures": "tsx src/commands/validateSigsa.ts --input fixtures/sigsa_desidentified.csv"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
